{
    "version": 1,
    "layers": [
        {
            "name": "static",
            "target": "STATIC",
            "directory": "browser"
        },
        {
            "name": "server",
            "target": "COMPUTE",
            "directory": "server",
            "entry": "server.mjs"
        }
    ],
    "routes": [
        {
            "pattern": "^/.*\\..*$",
            "layer": "static",
            "priority": 50
        },
        {
            "pattern": "^/.*$",
            "layer": "server",
            "priority": 0
        }
    ]
}